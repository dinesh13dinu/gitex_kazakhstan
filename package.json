{
  "name": "gitex-kazakhstan-cms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate": "wrangler d1 migrations apply gitex-kazakhstan-cms --local",
    "db:migrate:remote": "wrangler d1 migrations apply gitex-kazakhstan-cms --remote",
    "db:seed": "wrangler d1 execute gitex-kazakhstan-cms --local --file=seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute gitex-kazakhstan-cms --remote --file=seed/seed.sql",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
